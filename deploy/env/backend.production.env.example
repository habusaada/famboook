# Famboook Laravel API + Filament — Pilot production environment TEMPLATE.
# Copy to backend/.env ON THE SERVER ONLY (chmod 640, owner deploy:www-data).
# Never commit the real file. Every <...> value is a placeholder.
# See docs/08-PILOT-DEPLOYMENT.md.

APP_NAME=Famboook
APP_ENV=production
APP_DEBUG=false
# Generated once on the server with `php artisan key:generate --show`, then
# backed up offline (docs/08 §14). Never rotate without the documented plan.
APP_KEY=<generated-on-server>
# APP_PREVIOUS_KEYS=   # only during a planned key rotation (docs/08 §14)
APP_URL=https://api.famboook.com

# Staff Portal origin (CORS allowed origin) and Filament host.
FRONTEND_URL=https://famboook.com
ADMIN_DOMAIN=admin.famboook.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs: daily files, info level (user-administration audit events are
# logged at info), 90 days (docs/08 §15).
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL 16+ on localhost / private network only (docs/08 §11).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=famboook_pilot
DB_USERNAME=famboook_app
DB_PASSWORD=<set-on-server>

# Sessions: database driver, encrypted, HTTPS-only, shared by
# famboook.com (SPA must read XSRF-TOKEN), api. and admin. (docs/08 §4).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.famboook.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Only the Staff Portal host makes stateful (cookie) API calls.
SANCTUM_STATEFUL_DOMAINS=famboook.com

# CACHE_STORE=database also provides the atomic locks (cache_locks table) that
# the scheduler's withoutOverlapping / onOneServer and the notification worker
# heartbeat need — keep it a store SHARED by PHP-FPM, the worker and cron.
CACHE_STORE=database
# Queue: `sync` until the notification worker is installed (FB-NOTIFY-01E.1).
# Notifications refuse `sync` (no synchronous fallback): with it, publication
# stays closed (503) whatever NOTIFICATIONS_MODE says. The PILOT change, made
# only under the approved runbook (docs/deployment/
# FB-NOTIFY-01-PILOT-READINESS-CHECKLIST.md §5–§6), is:
#   QUEUE_CONNECTION=database
#   DB_QUEUE_RETRY_AFTER=90      # must stay > 60 (job timeout) and < 600 (stale threshold)
# Today the only queued jobs are the two notification jobs; SMS is sent after
# the response in the web process and is never queued; mail is `log`.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Import Apply activation gate (docs/08 "Import Apply activation"). MUST stay
# false until Apply is explicitly activated after the Apply UI phase and the
# final end-to-end review. Changing it alone does nothing: the documented
# activation procedure (config:clear, RolePermissionSeeder, verify-permissions)
# applies it. When true, import.apply is granted to SUPER_ADMIN only.
IMPORT_APPLY_ENABLED=false

# Family Portal (docs/08 section 16a, docs/11 section 30a). Placeholders only.
# FAMILY_AUTH_FINGERPRINT_KEY: a dedicated secret of at least 32 bytes
# (optionally "base64:..."), NEVER the APP_KEY. Empty = the Family Portal
# fingerprints fail closed; the Staff application is unaffected.
# The PREVIOUS key/version are set only during a key rotation.
FAMILY_AUTH_FINGERPRINT_KEY=
FAMILY_AUTH_FINGERPRINT_KEY_VERSION=1
# FAMILY_AUTH_FINGERPRINT_PREVIOUS_KEY=
# FAMILY_AUTH_FINGERPRINT_PREVIOUS_KEY_VERSION=
# Activation gate: keep false (SMS provider, queue worker, delivery failure
# handling and secure credentials are required first).
FAMILY_ACTIVATION_ENABLED=false
# Family login and password reset: separate gates, both off by default.
FAMILY_LOGIN_ENABLED=false
FAMILY_PASSWORD_RESET_ENABLED=false
# Signed-in Family password change (docs/11 FU-16): its own gate, off by
# default; no SMS. Limit: 5 attempts per 900 seconds per user.
FAMILY_PASSWORD_CHANGE_ENABLED=false
# Mobile contact update (docs/11 FP-ADR-079): its own gate, off by default.
# It SENDS SMS to numbers not yet in the registry: keep false until SMS
# delivery is Production-ready.
FAMILY_CONTACT_UPDATE_ENABLED=false
# Change Requests (docs/08 §16b, docs/11 FP-ADR-075): who may submit NEW
# family requests — OFF | PILOT | GENERAL (missing or invalid = OFF). Deploy
# with OFF; PILOT only under a written pilot authorization (docs/09); after any
# change: config:clear + optimize + reload PHP-FPM, then
# famboook:change-requests-check.
CHANGE_REQUESTS_FAMILY_SUBMISSION_MODE=OFF
# PILOT allowlist: canonical Family database ids, comma-separated. Set ONLY in
# the server .env — never write real ids into Git or a ticket.
CHANGE_REQUESTS_PILOT_FAMILY_IDS=
# Do NOT set CHANGE_REQUESTS_FAMILY_SUBMISSION_ENABLED: replaced, opens nothing.
# Coordinator requests (CO-02, docs/08 §16d, docs/06 AUTH-ADR-093): who may
# submit NEW Coordinator requests — OFF | PILOT | GENERAL (missing or invalid
# = OFF), independent of the family mode above. Deploy with OFF; PILOT only
# under a written coordinator pilot authorization (docs/09); after any change:
# config:clear + optimize + reload PHP-FPM, then famboook:change-requests-check.
CHANGE_REQUESTS_COORDINATOR_SUBMISSION_MODE=OFF
# PILOT allowlist: canonical user database ids of the authorized Coordinator
# accounts, comma-separated; one malformed entry = nobody. Set ONLY in the
# server .env — never write real ids into Git or a ticket.
CHANGE_REQUESTS_COORDINATOR_PILOT_USER_IDS=
# FAMILY_SMS_DRIVER: empty = nothing can be delivered. `tweetsms` = the
# Production provider (docs/08 §16a: validate with famboook:sms-check first).
# Never set it to `log` in Production (the development driver refuses to run
# here anyway).
FAMILY_SMS_DRIVER=
# TweetsMS (FAMILY_SMS_DRIVER=tweetsms): the API key and the sender are
# SECRETS — set them only in the server .env, never in the repository.
TWEETSMS_API_KEY=
TWEETSMS_SENDER=
# TWEETSMS_ENDPOINT=https://www.tweetsms.ps/api.php/office/sendsms
# TWEETSMS_CONNECT_TIMEOUT=3
# TWEETSMS_TIMEOUT=8
# OTP SMS abuse ceilings (optional overrides; these are the defaults).
# FAMILY_OTP_THROTTLE_PERSON_HOUR=5
# FAMILY_OTP_THROTTLE_PERSON_DAY=10
# FAMILY_OTP_THROTTLE_DESTINATION_HOUR=10
# FAMILY_OTP_THROTTLE_DESTINATION_DAY=20
# FAMILY_OTP_THROTTLE_IP_HOUR=20
# FAMILY_OTP_THROTTLE_GLOBAL_HOUR=500
# Finished OTP challenges are purged after this many days (default 90).
# FAMILY_OTP_RETENTION_DAYS=90
# Activation abuse controls. MIN_RESPONSE_MS is a development default: the
# Production value must exceed the real SMS provider's slow-case latency.
# FAMILY_ACTIVATION_MIN_RESPONSE_MS=400
# FAMILY_ACTIVATION_LIMIT_START_IP_MINUTE=10
# FAMILY_ACTIVATION_LIMIT_START_IP_HOUR=30
# FAMILY_ACTIVATION_LIMIT_START_IDENTIFIER_HOUR=5
# FAMILY_ACTIVATION_LIMIT_SEND_IP_MINUTE=10
# FAMILY_ACTIVATION_LIMIT_VERIFY_IP_MINUTE=30
# FAMILY_ACTIVATION_LIMIT_RESEND_IP_MINUTE=10
# FAMILY_ACTIVATION_LIMIT_COMPLETE_IP_MINUTE=10
# Family login lockout: attempts per IP, and FAILED attempts per identifier
# (from one IP / from any IP), all over the decay window.
# FAMILY_LOGIN_LIMIT_DECAY_SECONDS=900
# FAMILY_LOGIN_LIMIT_IP_ATTEMPTS=20
# FAMILY_LOGIN_LIMIT_IDENTIFIER_IP_FAILURES=5
# FAMILY_LOGIN_LIMIT_IDENTIFIER_FAILURES=20
# Password reset request ceilings (same pattern as activation).
# FAMILY_PASSWORD_RESET_LIMIT_START_IP_MINUTE=10
# FAMILY_PASSWORD_RESET_LIMIT_START_IP_HOUR=30
# FAMILY_PASSWORD_RESET_LIMIT_START_IDENTIFIER_HOUR=5
# FAMILY_PASSWORD_RESET_LIMIT_VERIFY_IP_MINUTE=30
# FAMILY_PASSWORD_RESET_LIMIT_RESEND_IP_MINUTE=10
# FAMILY_PASSWORD_RESET_LIMIT_COMPLETE_IP_MINUTE=10
# Self sensitive-value reveal ceilings per signed-in household head.
# FAMILY_SELF_REVEAL_LIMIT_USER_MINUTE=10
# FAMILY_SELF_REVEAL_LIMIT_USER_HOUR=60
# Household-member sensitive-value reveal ceilings per signed-in household head.
# FAMILY_MEMBER_REVEAL_LIMIT_USER_MINUTE=20
# FAMILY_MEMBER_REVEAL_LIMIT_USER_HOUR=120
# Coordinator Space members directory and audited reveal ceilings per
# signed-in Coordinator (CO-01C, docs/06 AUTH-ADR-092).
# COORDINATOR_DIRECTORY_LIMIT_USER_MINUTE=60
# COORDINATOR_REVEAL_LIMIT_USER_MINUTE=10
# COORDINATOR_REVEAL_LIMIT_USER_HOUR=60
# Coordinator Space reads (context, Families list, a Family summary; CO-02.7b).
# COORDINATOR_READ_LIMIT_USER_MINUTE=60
# Coordinator requests, per Coordinator (CO-02.4): submissions, resubmit /
# cancel, and reads (types, list, detail, form reference data).
# CHANGE_REQUESTS_COORDINATOR_SUBMIT_LIMIT_USER_MINUTE=5
# CHANGE_REQUESTS_COORDINATOR_SUBMIT_LIMIT_USER_HOUR=40
# CHANGE_REQUESTS_COORDINATOR_ACTION_LIMIT_USER_MINUTE=10
# CHANGE_REQUESTS_COORDINATOR_READ_LIMIT_USER_MINUTE=60
# Unified notifications (ADR FB-NOTIFY-01, docs/08 §16, docs/deployment/
# FB-NOTIFY-01-PILOT-READINESS-CHECKLIST.md). Deploy with OFF. OFF | PILOT |
# ON (missing or invalid = OFF). PILOT / ON only under the approved runbook,
# as its LAST step, after the queue, the worker and the scheduler are verified;
# after any change: config:clear + optimize + reload PHP-FPM + restart the
# worker, then famboook:notifications-check.
NOTIFICATIONS_MODE=OFF
# PILOT allow-list: canonical user database ids of the approved senders,
# comma-separated; one malformed entry = nobody. Set ONLY in the server .env —
# never write real ids into Git or a ticket.
NOTIFICATIONS_PILOT_SENDER_USER_IDS=
# PILOT households (ADR §2h): canonical family database ids, comma-separated;
# in PILOT an announcement may address ONLY these families, one by one, and
# only they see the family notification UI. One malformed entry = none.
# Server .env only — never real ids in Git or a ticket.
NOTIFICATIONS_PILOT_FAMILY_IDS=
# Not implemented yet (SYSTEM notifications, follow-ups): keep false / unset.
NOTIFICATIONS_SYSTEM_DISCOVERY_ENABLED=false
NOTIFICATIONS_FOLLOWUPS_ENABLED=false
# NOTIFICATIONS_SYSTEM_CUTOFF=
# NOTIFICATIONS_FOLLOWUPS_CUTOFF=                 # follow-ups: no backfill before it
# Defaults (optional overrides; readiness fails closed on invalid values):
# NOTIFICATIONS_QUEUE=notifications                # the worker listens on it
# NOTIFICATIONS_HEARTBEAT_MAX_AGE_SECONDS=300
# NOTIFICATIONS_AUTOMATIC_PUBLISH_ATTEMPTS=3
# NOTIFICATIONS_MANUAL_PUBLISH_RETRIES=1
# NOTIFICATIONS_STALE_PUBLISHING_SECONDS=600       # must exceed DB_QUEUE_RETRY_AFTER
# Do NOT set NOTIFICATIONS_MAX_PUBLISH_ATTEMPTS: replaced, changes nothing.
