# /etc/famboook/frontend-release.env — the active Next.js release (FB-DEVOPS-01).
# Read by the 20-release.conf drop-in; written by deploy/scripts/switch-frontend-release.sh.
# One line, no secrets. A legacy .next/<id> value is accepted during the migration only.
FAMBOOOK_NEXT_DIST_DIR=.builds/<release-id>
