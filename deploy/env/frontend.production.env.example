# Famboook Next.js Staff Portal — Pilot production TEMPLATE.
# Put in frontend/.env.production.local on the build machine/server.
# NEXT_PUBLIC_* values are PUBLIC: they are inlined into browser JavaScript
# at build time. Never place secrets here. `next build` refuses to run
# without NEXT_PUBLIC_API_URL.

NEXT_PUBLIC_API_URL=https://api.famboook.com
NEXT_PUBLIC_ADMIN_URL=https://admin.famboook.com/admin
