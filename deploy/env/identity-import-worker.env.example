# Famboook — civil identity import worker environment (FB-CIVIL-01A-UI U2 EXAMPLE).
#
# Copy to /etc/famboook/identity-import-worker.env (root:root 0600) and fill
# in on the server. NEVER commit the filled file; NEVER put these values in
# backend/.env. systemd reads it as root (EnvironmentFile=) before dropping
# to the famboook-import account (deploy/systemd/famboook-identity-import-worker.service).
# The worker reads nothing else: not backend/.env, not the cached configuration.

APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stderr
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Control-plane login (07-control-plane.dba.sql): famboook_civil_control_login.
# Requests, catalogue, heartbeats and audit only — no identity privilege.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=<database>
DB_USERNAME=famboook_civil_control_login
DB_PASSWORD=<set on the server>

# Identity import login (FB-CIVIL-01A 05-import-login.dba.sql): a member of
# famboook_identity_writer only. Must differ from the control-plane login.
IDENTITY_REF_DB_USERNAME=famboook_identity_import
IDENTITY_REF_DB_PASSWORD=<set on the server>

# The database the worker must be connected to (FB-CIVIL-01A --target check).
CIVIL_IMPORT_TARGET_DATABASE=<database>
# Server-side source root (one sub-directory per export; D-UI-3).
CIVIL_IMPORT_SOURCE_ROOT=/var/lib/famboook-import
CIVIL_IMPORT_CHUNK_SIZE=5000

# Publication is not implemented in U2; keep the gate closed (S-4).
CIVIL_IMPORT_PUBLISH_ENABLED=false

# Production approval reference (FB-CIVIL-01A-P4, X-7): ONLY after the
# real-data gates (G1 lawful basis, G3) are approved and recorded. Without it
# the worker refuses every execution request in production (NOT_APPROVED).
# IDENTITY_REF_PRODUCTION_APPROVAL=<change ticket>
