APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Import Apply activation gate (docs/08). Keep false: when true, the
# RolePermissionSeeder grants import.apply to SUPER_ADMIN only.
IMPORT_APPLY_ENABLED=false

# Family Portal (docs/08 section 16a, docs/11 section 30a). Placeholders only.
# FAMILY_AUTH_FINGERPRINT_KEY: a dedicated secret of at least 32 bytes
# (optionally "base64:..."), NEVER the APP_KEY. Empty = the Family Portal
# fingerprints fail closed; the Staff application is unaffected.
# The PREVIOUS key/version are set only during a key rotation.
FAMILY_AUTH_FINGERPRINT_KEY=
FAMILY_AUTH_FINGERPRINT_KEY_VERSION=1
# FAMILY_AUTH_FINGERPRINT_PREVIOUS_KEY=
# FAMILY_AUTH_FINGERPRINT_PREVIOUS_KEY_VERSION=
# Activation gate: keep false (SMS provider, queue worker, delivery failure
# handling and secure credentials are required first).
FAMILY_ACTIVATION_ENABLED=false
# Family login and password reset: separate gates, both off by default.
FAMILY_LOGIN_ENABLED=false
FAMILY_PASSWORD_RESET_ENABLED=false
# FAMILY_SMS_DRIVER: empty = nothing can be delivered. `log` is a LOCAL
# development driver only (it refuses to run outside local / testing).
# `tweetsms` sends real SMS (costs credit): Production only, normally.
FAMILY_SMS_DRIVER=
# TweetsMS (FAMILY_SMS_DRIVER=tweetsms): the API key and the sender are
# SECRETS — set them only in the server .env, never in the repository.
TWEETSMS_API_KEY=
TWEETSMS_SENDER=
# TWEETSMS_ENDPOINT=https://www.tweetsms.ps/api.php/office/sendsms
# TWEETSMS_CONNECT_TIMEOUT=3
# TWEETSMS_TIMEOUT=8
# OTP SMS abuse ceilings (optional overrides; these are the defaults).
# FAMILY_OTP_THROTTLE_PERSON_HOUR=5
# FAMILY_OTP_THROTTLE_PERSON_DAY=10
# FAMILY_OTP_THROTTLE_DESTINATION_HOUR=10
# FAMILY_OTP_THROTTLE_DESTINATION_DAY=20
# FAMILY_OTP_THROTTLE_IP_HOUR=20
# FAMILY_OTP_THROTTLE_GLOBAL_HOUR=500
# Finished OTP challenges are purged after this many days (default 90).
# FAMILY_OTP_RETENTION_DAYS=90
# Activation abuse controls. MIN_RESPONSE_MS is a development default: the
# Production value must exceed the real SMS provider's slow-case latency.
# FAMILY_ACTIVATION_MIN_RESPONSE_MS=400
# FAMILY_ACTIVATION_LIMIT_START_IP_MINUTE=10
# FAMILY_ACTIVATION_LIMIT_START_IP_HOUR=30
# FAMILY_ACTIVATION_LIMIT_START_IDENTIFIER_HOUR=5
# FAMILY_ACTIVATION_LIMIT_SEND_IP_MINUTE=10
# FAMILY_ACTIVATION_LIMIT_VERIFY_IP_MINUTE=30
# FAMILY_ACTIVATION_LIMIT_RESEND_IP_MINUTE=10
# FAMILY_ACTIVATION_LIMIT_COMPLETE_IP_MINUTE=10
# Family login lockout: attempts per IP, and FAILED attempts per identifier
# (from one IP / from any IP), all over the decay window.
# FAMILY_LOGIN_LIMIT_DECAY_SECONDS=900
# FAMILY_LOGIN_LIMIT_IP_ATTEMPTS=20
# FAMILY_LOGIN_LIMIT_IDENTIFIER_IP_FAILURES=5
# FAMILY_LOGIN_LIMIT_IDENTIFIER_FAILURES=20
# Password reset request ceilings (same pattern as activation).
# FAMILY_PASSWORD_RESET_LIMIT_START_IP_MINUTE=10
# FAMILY_PASSWORD_RESET_LIMIT_START_IP_HOUR=30
# FAMILY_PASSWORD_RESET_LIMIT_START_IDENTIFIER_HOUR=5
# FAMILY_PASSWORD_RESET_LIMIT_VERIFY_IP_MINUTE=30
# FAMILY_PASSWORD_RESET_LIMIT_RESEND_IP_MINUTE=10
# FAMILY_PASSWORD_RESET_LIMIT_COMPLETE_IP_MINUTE=10
# Self sensitive-value reveal ceilings per signed-in household head.
# FAMILY_SELF_REVEAL_LIMIT_USER_MINUTE=10
# FAMILY_SELF_REVEAL_LIMIT_USER_HOUR=60
# Household-member sensitive-value reveal ceilings per signed-in household head.
# FAMILY_MEMBER_REVEAL_LIMIT_USER_MINUTE=20
# FAMILY_MEMBER_REVEAL_LIMIT_USER_HOUR=120

# Change Requests (docs/05 WF-ADR-049 ... 052, docs/11 FP-ADR-075). Who may
# submit NEW family requests: OFF (default) | PILOT | GENERAL. Missing or
# invalid = OFF. Existing requests stay readable and can still be answered or
# cancelled; the Staff review workflow is unaffected.
CHANGE_REQUESTS_FAMILY_SUBMISSION_MODE=OFF
# PILOT only: comma-separated canonical Family database ids (e.g. 12,57).
# Empty = no Family; one malformed entry = no Family. Never commit real ids.
CHANGE_REQUESTS_PILOT_FAMILY_IDS=
# CHANGE_REQUESTS_FAMILY_SUBMISSION_ENABLED is REPLACED by the mode above and
# opens nothing; remove it (famboook:change-requests-check warns while set).
# Optional per-user ceilings on family submissions and on resubmit / cancel.
# CHANGE_REQUESTS_FAMILY_SUBMIT_LIMIT_USER_MINUTE=3
# CHANGE_REQUESTS_FAMILY_SUBMIT_LIMIT_USER_HOUR=20
# CHANGE_REQUESTS_FAMILY_ACTION_LIMIT_USER_MINUTE=10
